@page
@model LoginModel

@{
    ViewData["Title"] = "Sign in";
}

<h1></h1>
<br /><br />
<div class="container p-1 my-1 border" style="width: 300px; height: auto;padding: 100px 100px 100px 100px;">
    <div class="padding: 100px 100px 100px 100px;">
        <form id="account" method="post">
            <p>Sign In</p>
            <hr style="width: 100%; text-align: left; margin-left: 0; color: blue">

            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-info"><b>SIGN IN</b></button>
            </div>
            <div class="form-group">

                <hr style="width: 100%; text-align: left; margin-left: 0; color: blue">
                <p>New User</p>
                <p>
                    <button type="submit" class="btn btn-info" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"><b>SIGN UP</b></button>

                </p>
            </div>
        </form>
    </div>


</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
