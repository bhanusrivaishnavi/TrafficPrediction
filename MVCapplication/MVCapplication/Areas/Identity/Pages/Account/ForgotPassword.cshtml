@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}
<br />
<br />

<div class="container p-1 my-1 border" style="width: 350px; height: 300px;padding: 100px 100px 100px 100px;">
    <div style="height:280px; width:auto; align-content:center; align-items:center; padding: 10px 10px 10px 10px;">
        <form method="post">
            <h4>Enter your email to send the password reset link</h4><br />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
