@page
@model RegisterModel
@{
    ViewData["Title"] = "Sign Up";
}


<br />
<br />
<div class="container p-1 my-1 border" style="width: 350px; height: auto;padding: 100px 100px 100px 100px;">
    <div style="height:auto; width:auto; align-content:center; align-items:center; padding: 10px 10px 10px 10px;">
        <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h4>Sign Up</h4>
            <hr style="width: 100%; text-align: left; margin-left: 0; color: blue">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Input.FullName"></label>
                <input asp-for="Input.FullName" class="form-control" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-info"><b>SIGN UP</b></button>
        </form>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
