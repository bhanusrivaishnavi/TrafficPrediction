
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model UpdateUser
@{
    ViewData["Title"] = "User Management";
}

<html>

<head>
    <script type="text/javascript">
        var user =@User.Identity.Name;
    </script>
</head>

<body>
    <br /><br />
    <div class="row">
        <div class="col-md-6">
            <form id="frmDetail" method="post" action="UpdateRecord">
                <div class="form-group">
                    <input type="hidden" name="txtuser" asp-for="@User.Identity.Name" class="form-control" readonly />
                    <span asp-validation-for="@User.Identity.Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label>First Name</label>
                    <input name="txtFName" asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label>Last Name</label>
                    <input name="txtLName" asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Email"></label>
                    <input name="txtEmail" asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
              
                <div class="form-group">
                    <label asp-for="Input.NewPassword"></label>
                    <input name="txtpswd1" asp-for="Input.NewPassword" class="form-control" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.PhoneNumber"></label>
                    <input name="txtPhno" asp-for="Input.PhoneNumber" class="form-control" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
                <input type="submit" class="btn btn-info" value="Update" name="action" />


            </form>
        </div>
    </div>
</body>

</html>











