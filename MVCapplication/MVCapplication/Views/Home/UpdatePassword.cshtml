@{
    ViewData["Title"] = "Update Password";
}

<html>

<body>
    <style>
         li > a:hover {
            background-color: dodgerblue;
        }
       
    </style>
    <br />

    <h3>User Management</h3>

    <div class="row">
        <div id="div1" class="col-md-3">
            <ul class="nav nav-pills flex-column">
                <li class="nav-item"><a class="nav-link" href="UpdateUser">Profile</a></li>
                <li class="nav-item active"><a class="nav-link active" href="UpdatePassword">Change Password</a></li>
            </ul>
        </div>
        <div class="col-md-9">
            <h3>Update Password</h3> <br />
          
            <form id="frmDetail" method="post" action="UpdateRecord">
              <!--  <div class="form-group">
                    <label>Old Password</label>
                    <input name="oldpswd" type="password" class="form-control" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}" title="Must contain at least one number and one uppercase and lowercase letter, and at least 8 or more characters" />
                    <span class="text-danger"></span>
                </div> -->
                <div class="form-group">
                    <label>New Password</label>
                    <input name="newpswd" type="password" class="form-control" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}" title="Must contain at least one number and one uppercase and lowercase letter, and at least 8 or more characters" required/>
                    <span class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label>Confirm New Password</label>
                    <input name="newpswd1"type="password" class="form-control" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}" title="Must contain at least one number and one uppercase and lowercase letter, and at least 8 or more characters" required/>
                    <span class="text-danger"></span>
                </div>
                <input type="submit" class="btn btn-info" value="Change" name="action" />

                   @if (ViewBag.status != null)
                    {
                        <div class="alert alert-success" style="width:500px;margin:auto;" role="alert">
                           @ViewBag.status
                         </div>
                     }
                      @if (ViewBag.error != null)
                     {
                         <div class="alert alert-danger" style="width:500px;margin:auto;" role="alert">
                             @ViewBag.error
                               </div>
                      }
            </form>
            </div>
        </div>
    


</body>

</html>