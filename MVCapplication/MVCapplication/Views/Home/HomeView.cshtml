@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Home";
}
@model FileUpload
<html>

<body>
    <style>
        .nav > li > a:hover {
            background-color: dodgerblue;
        }
        p {
            background-color: black;
            color: white;
        }
    </style>
    <br />
    <div class="jumbotron h-25 w-100 p-3 mt-3 text-light" style="background-color:dimgrey">
        Welcome! @User.Identity.Name
    </div>

   

    <div class="row">
        <div class="col-md-3">
            
            <p>List of processed files</p>
            <ul class="navbar nav nav-fill" style="background-color:white;">

                @foreach (var value in (List<String>)ViewBag.files)
                {
                <li class="nav-item nav-tabs border" style="border-block-color:white;">
                    
                  
                    <a class="nav-link" href="/api/FileUpload/GetFileMetaData?fname=@value">@value.Substring(37, value.Length - 37 - 4)</a>
                </li>
                 }
                </ul>
        </div>
        
        <div>
            <a href="http://127.0.0.1:8000/process"><button type="button" class="btn btn-info">Process Files</button></a>
            
            

        </div>
       
    </div>


</body>

</html>