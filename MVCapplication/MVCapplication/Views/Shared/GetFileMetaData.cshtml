@{ 
    ViewData["Title"] = "Home"; 
}
@model FileUpload
<html>
<head>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>

        $(document).ready(function () {

            $("#search").on("click", function () {
                delay: 1000;
                var value = $("#myInput").val().toLowerCase();
                $("#myTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

        });
    </script>
</head>
<body>
    <style>
        .nav > li > a:hover {
            background-color: dodgerblue;
        }

        tr:nth-child(even) {
            background-color: palegreen;
        }

        p {
            background-color: black;
            color: white;
        }
    </style>
    <br />
    <div class="jumbotron h-25 w-100 p-3 mt-3 text-light" style="background-color:dimgrey">
        Welcome! @User.Identity.Name
    </div>

    <div class="row">
        <div class="col-md-3">
            <p>List of processed files</p>
            <ul class="navbar nav nav-fill" style="background-color:white;">
                @if (ViewBag.filenames != null)
                {
    @foreach (var value in (List<String>)ViewBag.filenames)
    {
<li class="nav-item nav-tabs border" style="border-block-color:white;">

    <a class="nav-link" href="/api/FileUpload/GetFileMetaData?fname=@value">@value.Substring(37, value.Length - 37 - 4)</a>
</li>}}
            </ul>
        </div>
        <div class="col-md-9">

            <p>Document Metadata</p>
            @if (ViewBag.filedetails != null)
            {
<h5>
    <span class="badge badge-secondary" style="display:inline-block;">Created By&nbsp;:</span>
    @ViewBag.filedetails[0]
</h5>
                <h5>
                    <span class="badge badge-secondary" style="display:inline;">Created On:</span>
                    @ViewBag.filedetails[1].Substring(0, 10)
                </h5>
                                <h5>
                                    <span class="badge badge-secondary" style="display:inline;">File Info&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:</span>
                                    @ViewBag.filedetails[2].Substring(37) <a class="buttoncli" href="/api/FileUpload/Download?fname=@ViewBag.filedetails[2]"><img src="~/css/Capture.PNG" alt="Download" width="30" height="30"></a>
                                </h5>            }
            <br />
            <p>Dataset</p>

            <div>
                <button type="button" class="btn btn-outline-success" data-toggle="modal" data-target="#exampleModalCenter">
                    Visualize
                </button>
                <!-- Modal -->
                <div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg" style=" max-height: 100%; height: auto; max-width: 100%; width: 850px; padding-left:10px;" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Visualization</h5>


                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <a href="http://127.0.0.1:8000/view_stats/@ViewBag.filedetails[2]" target="_blank"><button type="button" class="btn btn-success">View Stats</button></a>

                                @{ string file = ViewBag.filedetails[2];
                                                file = file.Replace(".csv", ".png");
                                    <img src="~/Graphs/@file" /> }
                            </div>

                        </div>
                    </div>
                </div>
                <input id="myInput" style="float:right;" type="text" placeholder="Search.."><a id="search" style="float: right;"><img src="~/css/Capture1.PNG" alt="Go" width="30" height="30"></a><br /><br />
                @if (ViewBag.usingcsvhelper != null)
                {

    <table class="table table-striped table-bordered table-responsive-sm">



        <thead style="border-color:lawngreen;">
            <tr class="bg-success">
                @foreach (var value in ViewBag.ColumnHeaders)
                {

<th style="column-width:200px;" scope="col">@value</th>}
            </tr>
        </thead>


        <tbody id="myTable">
            @foreach (IDictionary<string, object> row in ViewBag.usingcsvhelper)
            {
<tr>
    @for (int i = 0; i < @ViewBag.ColumnCount; i++)
    {
<td>@row.ElementAt(i).Value</td>}
</tr>}
        </tbody>
    </table>}
            </div>
        </div>
    </div>


</body>

</html>